{
  "routing_guard_mode": "enforce",
  "subagent_marker_fields": [
    "agent_id"
  ],
  "record_file": "WORKING_RECORD.md",
  "features_file": "FEATURES.md",
  "auto_fix_max_rounds": 1,
  "fable_planner_min_triggers": 2,
  "update_notice": "v3.2.10: dynamic workflows run under the rules (test-run limits reach workflow helpers; the ⏳ wait line when a workflow starts; each helper gets its role file; 'Task kind: test speed' doubles the test-run limits). Reports: Completion lines are Now / Next / Later; a reply with decisions is not sent back; a send-back asks for one line, not the whole report; the restart line goes to the record; /compact only above 50% context; a new report in docs/reports/ must reach you. GitHub: a notes-only push needs no new wait and gets the [skip ci] hint; a stacked pull request moves to main after its base merges. References are exact by default; checkpoint reports in long plans. Your apps get one setup pull request (hz-setup-update-3.2.10, one file). claude.ai preferences: unchanged.",
  "dispatch": {
    "UserPromptSubmit": [
      "plan-gate.py",
      "skill-router.py"
    ],
    "PreToolUse": [
      {
        "script": "rules-first-guard.py",
        "tools": ".*"
      },
      {
        "script": "worker-budget.py",
        "tools": ".*"
      },
      {
        "script": "routing-guard.py",
        "tools": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "script": "git-guard.py",
        "tools": "Bash|mcp__.*pull_request.*"
      },
      {
        "script": "plan-guard.py",
        "tools": "ExitPlanMode"
      },
      {
        "script": "plan-edit-guard.py",
        "tools": "Edit|Write|MultiEdit"
      },
      {
        "script": "worker-guard.py",
        "tools": "Agent|Task|Workflow"
      },
      {
        "script": "report-timing.py",
        "tools": "Agent|Task|Bash|Workflow"
      },
      {
        "script": "record-edit-guard.py",
        "tools": "Edit|Write|MultiEdit"
      },
      {
        "script": "wait-guard.py",
        "tools": "Bash"
      },
      {
        "script": "rules-read-guard.py",
        "tools": "Bash"
      }
    ],
    "Stop": [
      "setup-guard.py",
      "record-guard.py",
      "completion-guard.py",
      "handoff-guard.py",
      "pr-ready-guard.py",
      "validation-line.py",
      "qc-guard.py",
      "report-early.py",
      "report-delivery.py",
      "merge-guard.py",
      "stats.py"
    ],
    "PostToolUse": [
      {
        "script": "notice-reminder.py",
        "tools": "Bash|mcp__.*pull_request.*"
      },
      {
        "script": "test-speed.py",
        "tools": "Bash"
      }
    ]
  },
  "read_only_helpers": [
    "Explore",
    "reviewer",
    "planner",
    "planner-opus",
    "reviewer-light"
  ],
  "sonnet_max_tries": 2,
  "complex_words": [
    "root cause",
    "diagnos",
    "investigate",
    "redesign",
    "architecture",
    "data model",
    "schema",
    "migration",
    "firestore",
    "security rules",
    "sync",
    "shared state",
    "shared data",
    "refactor"
  ],
  "sonnet_protected_paths": [
    "firestore.rules",
    "firebase.json",
    ".firebaserc",
    "storage.rules",
    "package.json",
    "package-lock.json",
    ".github/",
    "sw.js",
    "service-worker",
    "schema",
    "migration"
  ],
  "destructive_phrases": [
    "delete (everything|all (the )?files|every (tracked )?file)",
    "empty (the|this|your) (repo|repository|folder)",
    "remove all files",
    "rm -rf",
    "git reset --hard",
    "push --force",
    "force[- ]push",
    "git clean -f",
    "delete the (repo|repository|branch main|main branch)",
    "wipe"
  ],
  "fresh_session_hint_tokens": 0,
  "context_window_tokens": 1000000,
  "notes_paths": [
    "WORKING_RECORD.md",
    "FEATURES.md",
    "docs/",
    "plans/"
  ],
  "worker_step_warn": 80,
  "worker_step_stop": 100,
  "worker_never_refuse": [
    "SubagentHandback",
    "TaskStop",
    "TodoWrite"
  ],
  "planner_helpers": [
    "planner",
    "planner-opus"
  ],
  "main_session_model": {
    "id": "claude-opus-5-5",
    "name": "Opus 5.5",
    "switch": "/model opus"
  }
}
